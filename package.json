{
  "name": "cutven",
  "productName": "Cutven",
  "version": "1.0.0",
  "description": "YouTube içerik üreticileri için sade, hızlı ve tamamen çevrimdışı video editörü",
  "author": "Ömer",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "ffmpeg-static@5.3.0": true
  },
  "build": {
    "appId": "com.cutven.app",
    "productName": "Cutven",
    "copyright": "© 2026 Cutven",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/**"
    ],
    "fileAssociations": [
      {
        "ext": "cutven",
        "name": "Cutven Projesi",
        "description": "Cutven video projesi",
        "icon": "build/icon.png",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Cutven-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cutven",
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "tr",
      "en-US"
    ]
  }
}
